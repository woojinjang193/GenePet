  KOR: "\uD398\uC774\uCF13\uC758 \uC720\uC804\uC790 \uC815\uBCF4\uB97C \uBCFC \uC218
    \uC788\uC5B4\uC694!\n\uC720\uC804\uC790 \uD3B8\uC9D1\uC744 \uD1B5\uD574\uC11C
    \uC6D0\uD558\uB294 \uAC1C\uCCB4\uB97C \uC5BB\uC5B4\uBCF4\uC138\uC694!"
  ENG: "You can view your Faecat\u2019s gene information!\nTry gene editing to get
    the Faecat you want!"
  DE: 'Hier kannst du die Gen-Informationen deines Faecat sehen!

    Versuch es
    mit Genbearbeitung, um den Faecat zu bekommen, den du willst!'
  SP: "\xA1Puedes ver la informaci\xF3n gen\xE9tica de tu Faecat!\n\xA1Prueba la
    edici\xF3n gen\xE9tica para obtener el Faecat que quieres!"
  JP: "\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306E\u907A\u4F1D\u5B50\u60C5\u5831\u3092\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\uFF01\n\u907A\u4F1D\u5B50\u7DE8\u96C6\u3067\u3001\u6B32\u3057\u3044\u500B\u4F53\u3092\u624B\u306B\u5165\u308C\u3066\u307F\u307E\u3057\u3087\u3046\uFF01"
  CHS: "\u4F60\u53EF\u4EE5\u67E5\u770B\u8D39\u732B\u7684\u57FA\u56E0\u4FE1\u606F\uFF01\n\u901A\u8FC7\u57FA\u56E0\u7F16\u8F91\u6765\u83B7\u5F97\u4F60\u60F3\u8981\u7684\u4E2A\u4F53\u5427\uFF01"
  CHT: "\u4F60\u53EF\u4EE5\u67E5\u770B\u8CBB\u8C93\u7684\u57FA\u56E0\u8CC7\u8A0A\uFF01\n\u900F\u904E\u57FA\u56E0\u7DE8\u8F2F\u4F86\u7372\u5F97\u4F60\u60F3\u8981\u7684\u500B\u9AD4\u5427\uFF01"
