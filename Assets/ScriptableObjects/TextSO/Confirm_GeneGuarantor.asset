  m_Script: {fileID: 11500000, guid: 3c7885e8e9a268046a087e585e2bd7f5, type: 3}
  m_Name: Confirm_GeneGuarantor
  m_EditorClassIdentifier: 
  KOR: "\uC774 \uC720\uC804\uC790\uB97C \uC6B0\uC131\uC73C\uB85C \uC6B0\uC120 \uC801\uC6A9\uD569\uB2C8\uB2E4.\n<color=red>\uC0C1\uB300\uB3C4
    \uAC19\uC740 \uC720\uC804\uC790 \uD0C0\uC785\uC5D0 \uC6B0\uC120 \uC801\uC6A9\uC774
    \uB418\uC5B4 \uC788\uB2E4\uBA74 \uC6B0\uC131/\uC5F4\uC131\uC740 50:50 \uD655\uB960\uB85C
    \uACB0\uC815\uB429\uB2C8\uB2E4.</color>"
  ENG: 'This gene is given Dominant Priority.

    <color=red>If the other side also
    applies Dominant Priority to the same gene type, dominance/recessiveness is decided
    with a 50:50 chance.</color>'
  DE: "Diesem Gen wird dominante Priorit\xE4t zugewiesen.\n<color=red>Wenn die Gegenseite
    ebenfalls dominante Priorit\xE4t auf denselben Gentyp angewendet hat, wird Dominanz/Rezessivit\xE4t
    mit 50:50 Wahrscheinlichkeit entschieden.</color>"
  SP: "Este gen recibe Prioridad Dominante.\n<color=red>Si la otra parte tambi\xE9n
    aplica Prioridad Dominante al mismo tipo de gen, la dominancia/recesividad se
    decide con una probabilidad 50:50.</color>"
  JP: "\u3053\u306E\u907A\u4F1D\u5B50\u306B\u512A\u6027\u512A\u5148\u6A29\u3092\u4ED8\u4E0E\u3057\u307E\u3059\u3002\n<color=red>\u76F8\u624B\u3082\u540C\u3058\u907A\u4F1D\u5B50\u30BF\u30A4\u30D7\u306B\u512A\u6027\u512A\u5148\u6A29\u3092\u4ED8\u4E0E\u3057\u3066\u3044\u308B\u5834\u5408\u3001\u512A\u6027\uFF0F\u52A3\u6027\u306F50:50\u306E\u78BA\u7387\u3067\u6C7A\u307E\u308A\u307E\u3059\u3002</color>"
  CHS: "\u4E3A\u8BE5\u57FA\u56E0\u8D4B\u4E88\u4F18\u6027\u4F18\u5148\u6743\u3002\n<color=red>\u5982\u679C\u5BF9\u65B9\u4E5F\u5BF9\u76F8\u540C\u7684\u57FA\u56E0\u7C7B\u578B\u8D4B\u4E88\u4E86\u4F18\u6027\u4F18\u5148\u6743\uFF0C\u5219\u4F18\u6027/\u9690\u6027\u5C06\u4EE550:50\u7684\u6982\u7387\u51B3\u5B9A\u3002</color>"
  CHT: "\u70BA\u8A72\u57FA\u56E0\u8CE6\u4E88\u512A\u6027\u512A\u5148\u6B0A\u3002\n<color=red>\u5982\u679C\u5C0D\u65B9\u4E5F\u5C0D\u76F8\u540C\u7684\u57FA\u56E0\u985E\u578B\u8CE6\u4E88\u4E86\u512A\u6027\u512A\u5148\u6B0A\uFF0C\u5247\u512A\u6027/\u96B1\u6027\u5C07\u4EE550:50\u7684\u6A5F\u7387\u6C7A\u5B9A\u3002</color>"
