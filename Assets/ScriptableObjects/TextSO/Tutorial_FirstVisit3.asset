  JP: "\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u305F\u3061\u306F\u3053\u3053\u3067\u751F\u307E\u308C\u3001\u80B2\u3061\u3001\u30D1\u30FC\u30C8\u30CA\u30FC\u3068\u51FA\u4F1A\u3063\u3066\u5375\u3092\u7523\u3080\u3053\u3068\u3082\u3042\u308A\u307E\u3059\uFF01"
  CHS: "\u8D39\u732B\u4EEC\u5728\u8FD9\u91CC\u51FA\u751F\u3001\u6210\u957F\uFF0C\u4E5F\u4F1A\u9047\u5230\u4F19\u4F34\u5E76\u4EA7\u4E0B\u86CB\uFF01"
