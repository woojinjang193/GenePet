  KOR: "\uC720\uC804\uC790 \uD3B8\uC9D1\uC740 \uC5B4\uB978 \uAC1C\uCCB4\uB9CC \uAC00\uB2A5\uD574\uC694.\n\uD398\uC774\uCF13\uC774
    \uC5B4\uB978\uC774 \uB418\uBA74 \uB2E4\uC2DC \uC54C\uB824\uB4DC\uB9B4\uAC8C\uC694!"
  ENG: "Gene editing is only available for adults.\nWhen your Faecat becomes an adult,
    I\u2019ll tell you again!"
  DE: "Genbearbeitung ist nur bei erwachsenen Faecats m\xF6glich.\nWenn dein Faecat
    erwachsen ist, sage ich dir nochmal Bescheid!"
  SP: "La edici\xF3n gen\xE9tica solo est\xE1 disponible para adultos.\nCuando tu
    Faecat sea adulto, te lo volver\xE9 a explicar."
  JP: "\u907A\u4F1D\u5B50\u7DE8\u96C6\u306F\u5927\u4EBA\u306E\u500B\u4F53\u3060\u3051\u53EF\u80FD\u3067\u3059\u3002\n\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u304C\u5927\u4EBA\u306B\u306A\u3063\u305F\u3089\u3001\u307E\u305F\u6559\u3048\u307E\u3059\u306D\uFF01"
  CHS: "\u57FA\u56E0\u7F16\u8F91\u53EA\u80FD\u5BF9\u6210\u4F53\u8FDB\u884C\u3002\n\u7B49\u8D39\u732B\u957F\u6210\u6210\u4F53\u540E\uFF0C\u6211\u4F1A\u518D\u544A\u8BC9\u4F60\uFF01"
  CHT: "\u57FA\u56E0\u7DE8\u8F2F\u53EA\u80FD\u5C0D\u6210\u9AD4\u9032\u884C\u3002\n\u7B49\u8CBB\u8C93\u9577\u6210\u6210\u9AD4\u5F8C\uFF0C\u6211\u6703\u518D\u544A\u8A34\u4F60\uFF01"
