  KOR: "\uC720\uC804\uC790\uC758 \uC774\uBBF8\uC9C0\uC5D0\uC694!\n\uC67C\uCABD\uC740
    \uC678\uD615\uC5D0 \uB4DC\uB7EC\uB098\uB294 \"\uC6B0\uC131\"\uC720\uC804\uC790,\n\uC624\uB978\uCABD\uC740
    \uC228\uC5B4\uC788\uB294 \"\uC5F4\uC131\"\uC720\uC804\uC790\uC608\uC694!"
  ENG: "This is the gene image!\nLeft is the visible \u201Cdominant\u201D gene,\nright
    is the hidden \u201Crecessive\u201D gene!"
  DE: "Das ist das Gen-Bild!\nLinks ist das sichtbare \u201Edominante\u201C Gen,\nrechts
    ist das versteckte \u201Erezessive\u201C Gen!"
  SP: "\xA1Esta es la imagen del gen!\nA la izquierda est\xE1 el gen \u201Cdominante\u201D
    visible,\ny a la derecha el gen \u201Crecesivo\u201D oculto."
  JP: "\u907A\u4F1D\u5B50\u306E\u753B\u50CF\u3067\u3059\uFF01\n\u5DE6\u304C\u5916\u898B\u306B\u73FE\u308C\u308B\u300C\u512A\u6027\u300D\u907A\u4F1D\u5B50\u3001\n\u53F3\u304C\u96A0\u308C\u3066\u3044\u308B\u300C\u52A3\u6027\u300D\u907A\u4F1D\u5B50\u3067\u3059\uFF01"
  CHS: "\u8FD9\u662F\u57FA\u56E0\u7684\u56FE\u50CF\uFF01\n\u5DE6\u8FB9\u662F\u5916\u89C2\u4E0A\u4F1A\u8868\u73B0\u51FA\u6765\u7684\u201C\u663E\u6027\u201D\u57FA\u56E0\uFF0C\n\u53F3\u8FB9\u662F\u9690\u85CF\u7684\u201C\u9690\u6027\u201D\u57FA\u56E0\uFF01"
  CHT: "\u9019\u662F\u57FA\u56E0\u7684\u5716\u50CF\uFF01\n\u5DE6\u908A\u662F\u5916\u89C0\u4E0A\u6703\u8868\u73FE\u51FA\u4F86\u7684\u300C\u986F\u6027\u300D\u57FA\u56E0\uFF0C\n\u53F3\u908A\u662F\u96B1\u85CF\u7684\u300C\u96B1\u6027\u300D\u57FA\u56E0\uFF01"
