  m_EditorClassIdentifier: 
  KOR: "\uC774\uAC74 \uC131\uC7A5 \uBD80\uC2A4\uD130\uC5D0\uC694.\n\uD398\uC774\uCF13\uC5D0\uAC8C
    \uC0AC\uC6A9\uD558\uBA74 \uBC14\uB85C \uB2E4\uC74C\uB2E8\uACC4\uB85C \uC131\uC7A5
    \uC2DC\uD0AC \uC218 \uC788\uC5B4\uC694.\n\uC0AC\uC6A9\uD574\uBD10\uC694!"
  ENG: 'This is a Growth Booster.

    If you use it on a Faecat, it will grow immediately
    to the next stage.

    Try using it!'
  DE: "Das ist ein Wachstums-Booster.\nWenn du ihn bei einem Faecat benutzt, w\xE4chst
    er sofort in die n\xE4chste Stufe.\nProbier\u2019s aus!"
  SP: "Esto es un Acelerador de crecimiento.\nSi lo usas en un Faecat, crecer\xE1
    inmediatamente a la siguiente etapa.\n\xA1Pru\xE9balo!"
  JP: "\u3053\u308C\u306F\u6210\u9577\u30D6\u30FC\u30B9\u30BF\u30FC\u3067\u3059\u3002\n\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306B\u4F7F\u3046\u3068\u3001\u3059\u3050\u306B\u6B21\u306E\u6BB5\u968E\u3078\u6210\u9577\u3067\u304D\u307E\u3059\u3002\n\u4F7F\u3063\u3066\u307F\u307E\u3057\u3087\u3046\uFF01"
  CHS: "\u8FD9\u662F\u6210\u957F\u52A0\u901F\u5668\u3002\n\u5BF9\u8D39\u732B\u4F7F\u7528\u540E\uFF0C\u4F1A\u7ACB\u523B\u6210\u957F\u5230\u4E0B\u4E00\u9636\u6BB5\u3002\n\u8BD5\u7740\u7528\u7528\u770B\u5427\uFF01"
  CHT: "\u9019\u662F\u6210\u9577\u52A0\u901F\u5668\u3002\n\u5C0D\u8CBB\u8C93\u4F7F\u7528\u5F8C\uFF0C\u6703\u7ACB\u523B\u6210\u9577\u5230\u4E0B\u4E00\u968E\u6BB5\u3002\n\u8A66\u8457\u7528\u7528\u770B\u5427\uFF01"
