  KOR: "\uC5EC\uAE30\uC11C\uB3C4 \uC720\uC804\uC790\uB97C \uD3B8\uC9D1\uD560 \uC218
    \uC788\uB2F5\uB2C8\uB2E4!\n\uC774\uACF3\uC5D0\uC11C\uB294 \uC0C1\uB300 \uD398\uC774\uCF13\uC758
    \uC720\uC804\uC790 \uC815\uBCF4\uB3C4 \uBCF4\uACE0 \uD3B8\uC9D1\uD560 \uC218
    \uC788\uC5B4\uC694."
  ENG: "You can edit genes here too!\nIn this place, you can also view and edit the
    other Faecat\u2019s gene information."
  DE: "Auch hier kannst du Gene bearbeiten!\nAn diesem Ort kannst du au\xDFerdem
    die Gen-Infos des anderen Faecat ansehen und bearbeiten."
  SP: "\xA1Aqu\xED tambi\xE9n puedes editar genes!\nEn este lugar, tambi\xE9n puedes
    ver y editar la informaci\xF3n gen\xE9tica del Faecat contrario."
  JP: "\u3053\u3053\u3067\u3082\u907A\u4F1D\u5B50\u7DE8\u96C6\u304C\u3067\u304D\u307E\u3059\uFF01\n\u3053\u3053\u3067\u306F\u76F8\u624B\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306E\u907A\u4F1D\u5B50\u60C5\u5831\u3082\u898B\u305F\u308A\u7DE8\u96C6\u3057\u305F\u308A\u3067\u304D\u307E\u3059\u3002"
  CHS: "\u5728\u8FD9\u91CC\u4E5F\u53EF\u4EE5\u8FDB\u884C\u57FA\u56E0\u7F16\u8F91\uFF01\n\u5728\u8FD9\u91CC\u4F60\u8FD8\u80FD\u67E5\u770B\u5E76\u7F16\u8F91\u5BF9\u65B9\u8D39\u732B\u7684\u57FA\u56E0\u4FE1\u606F\u3002"
  CHT: "\u5728\u9019\u88E1\u4E5F\u53EF\u4EE5\u9032\u884C\u57FA\u56E0\u7DE8\u8F2F\uFF01\n\u5728\u9019\u88E1\u4F60\u9084\u80FD\u67E5\u770B\u4E26\u7DE8\u8F2F\u5C0D\u65B9\u8CBB\u8C93\u7684\u57FA\u56E0\u8CC7\u8A0A\u3002"
