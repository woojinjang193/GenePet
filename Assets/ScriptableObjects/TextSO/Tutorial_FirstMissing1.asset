  KOR: "\uD398\uC774\uCF13\uC740 \uAD00\uC2EC\uC744 \uC8FC\uC9C0\uC54A\uACE0 \uC624\uB798
    \uBC29\uCE58\uD558\uBA74 \uB5A0\uB098\uBC84\uB9B0\uB2F5\uB2C8\uB2E4."
  ENG: If you leave a Faecat alone without giving it attention for too long, it will
    leave.
  DE: "Wenn du einem Faecat lange Zeit keine Aufmerksamkeit schenkst und ihn vernachl\xE4ssigst,
    geht er weg."
  SP: "Si dejas a un Faecat sin atenci\xF3n durante mucho tiempo, se ir\xE1."
  JP: "\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306F\u3001\u304B\u307E\u3063\u3066\u3042\u3052\u305A\u306B\u9577\u3044\u9593\u653E\u3063\u3066\u304A\u304F\u3068\u3044\u306A\u304F\u306A\u3063\u3066\u3057\u307E\u3046\u3093\u3067\u3059\u3002"
  CHS: "\u8D39\u732B\u5982\u679C\u957F\u65F6\u95F4\u4E0D\u88AB\u5173\u6CE8\u3001\u4E00\u76F4\u88AB\u653E\u7740\u4E0D\u7BA1\uFF0C\u5C31\u4F1A\u79BB\u5F00\u3002"
  CHT: "\u8CBB\u8C93\u5982\u679C\u9577\u6642\u9593\u4E0D\u88AB\u95DC\u6CE8\u3001\u4E00\u76F4\u88AB\u653E\u8457\u4E0D\u7BA1\uFF0C\u5C31\u6703\u96E2\u958B\u3002"
