  KOR: "\uD398\uC774\uCF13\uC758 \uC720\uC804\uC790 \uC885\uB958\uC5D0\uC694.\n\uD3B8\uC9D1\uC744
    \uC6D0\uD558\uB294 \uC720\uC804\uC790\uC758 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD574\uC11C
