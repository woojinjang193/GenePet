  JP: "\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306E\u907A\u4F1D\u5B50\u306E\u7A2E\u985E\u3067\u3059\u3002\n\u7DE8\u96C6\u3057\u305F\u3044\u907A\u4F1D\u5B50\u306E\u30DC\u30BF\u30F3\u3092\u30BF\u30C3\u30D7\u3057\u3066\u7DE8\u96C6\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  CHS: "\u8FD9\u662F\u8D39\u732B\u7684\u57FA\u56E0\u79CD\u7C7B\u3002\n\u70B9\u51FB\u60F3\u8981\u7F16\u8F91\u7684\u57FA\u56E0\u6309\u94AE\u5373\u53EF\u7F16\u8F91\u3002"
  CHT: "\u9019\u662F\u8CBB\u8C93\u7684\u57FA\u56E0\u7A2E\u985E\u3002\n\u9EDE\u64CA\u60F3\u8981\u7DE8\u8F2F\u7684\u57FA\u56E0\u6309\u9215\u5373\u53EF\u7DE8\u8F2F\u3002"
