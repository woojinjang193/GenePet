  KOR: "\uC120\uBB3C\uC740 \uBBF8\uB2C8\uAC8C\uC784\uC5D0\uC11C \uC5BB\uC744 \uC218
    \uC788\uC5B4\uC694!\n\uBBF8\uB2C8\uAC8C\uC784\uB9C8\uB2E4 \uC5BB\uC744 \uC218
    \uC788\uB294 \uC120\uBB3C\uC774 \uB2E4\uB974\uB2F5\uB2C8\uB2E4!"
  ENG: 'You can get gifts from mini-games!

    Each mini-game offers different gifts!'
  DE: 'Geschenke kannst du in Minispielen erhalten!

    Je nach Minispiel bekommst
    du unterschiedliche Geschenke!'
  SP: "\xA1Puedes conseguir regalos en los minijuegos!\n\xA1Cada minijuego ofrece
    regalos distintos!"
  JP: "\u30D7\u30EC\u30BC\u30F3\u30C8\u306F\u30DF\u30CB\u30B2\u30FC\u30E0\u3067\u624B\u306B\u5165\u308A\u307E\u3059\uFF01\n\u30DF\u30CB\u30B2\u30FC\u30E0\u3054\u3068\u306B\u624B\u306B\u5165\u308B\u30D7\u30EC\u30BC\u30F3\u30C8\u304C\u9055\u3044\u307E\u3059\uFF01"
  CHS: "\u793C\u7269\u53EF\u4EE5\u901A\u8FC7\u5C0F\u6E38\u620F\u83B7\u5F97\uFF01\n\u6BCF\u4E2A\u5C0F\u6E38\u620F\u80FD\u83B7\u5F97\u7684\u793C\u7269\u90FD\u4E0D\u4E00\u6837\uFF01"
  CHT: "\u79AE\u7269\u53EF\u4EE5\u900F\u904E\u5C0F\u904A\u6232\u7372\u5F97\uFF01\n\u6BCF\u500B\u5C0F\u904A\u6232\u80FD\u7372\u5F97\u7684\u79AE\u7269\u90FD\u4E0D\u4E00\u6A23\uFF01"
