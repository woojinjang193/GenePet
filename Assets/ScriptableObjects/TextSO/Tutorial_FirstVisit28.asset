  JP: "\u30A8\u30B5\u306B\u306F\u30D0\u30CA\u30CA\u3068\u30B9\u30DA\u30B7\u30E3\u30EB\u30D0\u30CA\u30CA\u304C\u3042\u308A\u307E\u3059\u3002\n\u30B9\u30DA\u30B7\u30E3\u30EB\u30D0\u30CA\u30CA\u3092\u98DF\u3079\u3055\u305B\u308B\u3068\u7D4C\u9A13\u5024\u3082\u5897\u3048\u307E\u3059\uFF01"
  CHS: "\u98DF\u7269\u6709\u9999\u8549\u548C\u7279\u522B\u9999\u8549\u3002\n\u5582\u7279\u522B\u9999\u8549\u4E5F\u4F1A\u589E\u52A0\u7ECF\u9A8C\u503C\uFF01"
