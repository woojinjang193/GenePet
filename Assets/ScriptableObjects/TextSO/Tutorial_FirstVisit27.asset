  m_EditorClassIdentifier: 
  KOR: "\uC774\uAC74 \uBA39\uC774\uC8FC\uAE30 \uBC84\uD2BC\uC774\uC5D0\uC694.\n\uD398\uC774\uCF13\uC774
    \uBC30\uACE0\uD30C\uD560 \uB550 \uBC14\uB098\uB098\uB97C \uC8FC\uC138\uC694!\n\uD398\uC774\uCF13\uB4E4\uC740
    \uBC14\uB098\uB098\uB97C \uCC38 \uC88B\uC544\uD55C\uB2F5\uB2C8\uB2E4."
  ENG: 'This is the Feed button.

    When your Faecat is hungry, give it a banana!

    Faecats
    really love bananas.'
  DE: "Das ist der \u201EF\xFCttern\u201C-Button.\nWenn dein Faecat hungrig ist,
    gib ihm eine Banane!\nFaecats lieben Bananen."
  SP: "Este es el bot\xF3n de Dar de comer.\n\xA1Cuando tu Faecat tenga hambre, dale
    una banana!\nA los Faecats les encantan las bananas."
  JP: "\u3053\u308C\u306F\u300C\u30A8\u30B5\u3092\u3042\u3052\u308B\u300D\u30DC\u30BF\u30F3\u3067\u3059\u3002\n\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u304C\u7A7A\u8179\u306E\u3068\u304D\u306F\u30D0\u30CA\u30CA\u3092\u3042\u3052\u3066\u304F\u3060\u3055\u3044\uFF01\n\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306F\u30D0\u30CA\u30CA\u304C\u5927\u597D\u304D\u306A\u3093\u3067\u3059\u3002"
  CHS: "\u8FD9\u662F\u201C\u5582\u98DF\u201D\u6309\u94AE\u3002\n\u5F53\u8D39\u732B\u997F\u4E86\u7684\u65F6\u5019\uFF0C\u8BF7\u7ED9\u5B83\u9999\u8549\uFF01\n\u8D39\u732B\u4EEC\u975E\u5E38\u559C\u6B22\u9999\u8549\u3002"
  CHT: "\u9019\u662F\u300C\u9935\u98DF\u300D\u6309\u9215\u3002\n\u7576\u8CBB\u8C93\u9913\u4E86\u7684\u6642\u5019\uFF0C\u8ACB\u7D66\u7260\u9999\u8549\uFF01\n\u8CBB\u8C93\u5011\u975E\u5E38\u559C\u6B61\u9999\u8549\u3002"
