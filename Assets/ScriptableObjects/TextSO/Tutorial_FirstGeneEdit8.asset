  KOR: "\uD55C\uBC88 \uC0AC\uC6A9\uD558\uBA74 \uD574\uB2F9 \uD398\uC774\uCF13\uC758
    \uC815\uBCF4\uB294 \uC5B8\uC81C\uB4E0 \uBCFC \uC218 \uC788\uC5B4\uC694!\n\uD55C\uBC88
