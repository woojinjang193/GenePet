  JP: "\u4E00\u5EA6\u4F7F\u3048\u3070\u3001\u305D\u306E\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306E\u60C5\u5831\u306F\u3044\u3064\u3067\u3082\u898B\u3089\u308C\u307E\u3059\uFF01\n\u4F7F\u3063\u3066\u307F\u307E\u3057\u3087\u3046\u304B\uFF1F"
  CHS: "\u53EA\u8981\u4F7F\u7528\u4E00\u6B21\uFF0C\u5C31\u80FD\u968F\u65F6\u67E5\u770B\u8BE5\u8D39\u732B\u7684\u4FE1\u606F\uFF01\n\u8981\u4E0D\u8981\u8BD5\u7528\u4E00\u4E0B\uFF1F"
  CHT: "\u53EA\u8981\u4F7F\u7528\u4E00\u6B21\uFF0C\u5C31\u80FD\u96A8\u6642\u67E5\u770B\u8A72\u8CBB\u8C93\u7684\u8CC7\u8A0A\uFF01\n\u8981\u4E0D\u8981\u8A66\u7528\u4E00\u4E0B\uFF1F"
