  m_Script: {fileID: 11500000, guid: 3c7885e8e9a268046a087e585e2bd7f5, type: 3}
  m_Name: Tutorial_FirstIsland1
  m_EditorClassIdentifier: 
  KOR: "\uC774\uACF3\uC5D0\uC120 \uB79C\uB364\uD55C \uD398\uC774\uCF13\uB4E4\uC744
    \uB9CC\uB0A0 \uC218 \uC788\uC5B4\uC694!\n\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uD398\uC774\uCF13\uC744
    \uB9CC\uB0AC\uB2E4\uBA74 \uC120\uBB3C\uC744 \uC8FC\uACE0 \uD638\uAC10\uB3C4\uB97C
    \uC62C\uB824 \uB2E4\uC74C \uC138\uB300\uC758 \uD398\uC774\uCF13\uC744 \uB9CC\uB098\uBD10\uC694!"
  ENG: 'Here, you can meet random Faecats!

    If you meet a Faecat you like, give
    it gifts and raise affinity to meet the next generation of Faecats!'
  DE: "Hier kannst du zuf\xE4llige Faecats treffen!\nWenn du ein Faecat triffst,
    das dir gef\xE4llt, gib ihm Geschenke und erh\xF6he die Affinit\xE4t, um die
    n\xE4chste Generation von Faecats zu treffen!"
  SP: "\xA1Aqu\xED puedes conocer Faecats aleatorios!\nSi encuentras un Faecat que
    te gusta, dale regalos y aumenta la afinidad para conocer a la siguiente generaci\xF3n
    de Faecats."
  JP: "\u3053\u3053\u3067\u306F\u30E9\u30F3\u30C0\u30E0\u306A\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u305F\u3061\u306B\u51FA\u4F1A\u3048\u307E\u3059\uFF01\n\u6C17\u306B\u5165\u3063\u305F\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306B\u51FA\u4F1A\u3063\u305F\u3089\u3001\u30D7\u30EC\u30BC\u30F3\u30C8\u3092\u3042\u3052\u3066\u89AA\u5BC6\u5EA6\u3092\u4E0A\u3052\u3001\u6B21\u306E\u4E16\u4EE3\u306E\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306B\u4F1A\u3063\u3066\u307F\u307E\u3057\u3087\u3046\uFF01"
  CHS: "\u5728\u8FD9\u91CC\u4F60\u53EF\u4EE5\u9047\u5230\u968F\u673A\u7684\u8D39\u732B\uFF01\n\u5982\u679C\u9047\u5230\u559C\u6B22\u7684\u8D39\u732B\uFF0C\u5C31\u9001\u793C\u7269\u63D0\u5347\u4EB2\u5BC6\u5EA6\uFF0C\u53BB\u89C1\u4E0B\u4E00\u4EE3\u7684\u8D39\u732B\u5427\uFF01"
  CHT: "\u5728\u9019\u88E1\u4F60\u53EF\u4EE5\u9047\u5230\u96A8\u6A5F\u7684\u8CBB\u8C93\uFF01\n\u5982\u679C\u9047\u5230\u559C\u6B61\u7684\u8CBB\u8C93\uFF0C\u5C31\u9001\u79AE\u7269\u63D0\u5347\u89AA\u5BC6\u5EA6\uFF0C\u53BB\u898B\u4E0B\u4E00\u4EE3\u7684\u8CBB\u8C93\u5427\uFF01"
