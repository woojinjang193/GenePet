  m_EditorClassIdentifier: 
  KOR: "\uB180\uC544\uC8FC\uAE30 \uBC84\uD2BC\uC774\uC5D0\uC694!\n\uBBF8\uB2C8\uAC8C\uC784\uC744
    \uD574\uC11C \uACE8\uB4DC, \uC544\uC774\uD15C, \uC6B4\uC774 \uC88B\uC73C\uBA74
    \uC54C\uAE4C\uC9C0 \uC5BB\uC744 \uC218 \uC788\uC5B4\uC694!"
  ENG: 'This is the Play button!

    By playing mini-games, you can earn gold, items,
    and if you''re lucky, even eggs!'
  DE: "Das ist der \u201ESpielen\u201C-Button!\nMit Minispielen kannst du Gold und
    Items verdienen \u2013 und mit etwas Gl\xFCck sogar Eier!"
  SP: "\xA1Este es el bot\xF3n de Jugar!\nAl jugar minijuegos, puedes ganar oro,
    objetos y, con suerte, \xA1hasta huevos!"
  JP: "\u3053\u308C\u306F\u300C\u904A\u3076\u300D\u30DC\u30BF\u30F3\u3067\u3059\uFF01\n\u30DF\u30CB\u30B2\u30FC\u30E0\u3067\u30B4\u30FC\u30EB\u30C9\u3084\u30A2\u30A4\u30C6\u30E0\u3092\u7372\u5F97\u3067\u304D\u3001\u904B\u304C\u826F\u3051\u308C\u3070\u5375\u3082\u624B\u306B\u5165\u308A\u307E\u3059\uFF01"
  CHS: "\u8FD9\u662F\u201C\u73A9\u800D\u201D\u6309\u94AE\uFF01\n\u901A\u8FC7\u5C0F\u6E38\u620F\u53EF\u4EE5\u83B7\u5F97\u91D1\u5E01\u3001\u9053\u5177\uFF0C\u8FD0\u6C14\u597D\u7684\u8BDD\u8FD8\u80FD\u5F97\u5230\u86CB\uFF01"
  CHT: "\u9019\u662F\u300C\u73A9\u800D\u300D\u6309\u9215\uFF01\n\u900F\u904E\u5C0F\u904A\u6232\u53EF\u4EE5\u7372\u5F97\u91D1\u5E63\u3001\u9053\u5177\uFF0C\u904B\u6C23\u597D\u7684\u8A71\u9084\u80FD\u5F97\u5230\u86CB\uFF01"
