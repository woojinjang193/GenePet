  m_EditorClassIdentifier: 
  KOR: "\uC774\uAC74 \"\uC6B0\uC131 \uC6B0\uC120\uAD8C\"\uC774\uC5D0\uC694.\n\uC0AC\uC6A9\uD558\uBA74
    \uD574\uB2F9 \uC720\uC804\uC790\uAC00 \uC804\uB2EC\uB420 \uB54C \uC6B0\uC131\uC73C\uB85C
    \uC6B0\uC120 \uBC30\uCE58\uB3FC\uC694."
  ENG: "This is \u201CDominant Priority\u201D.\nWhen used, that gene is prioritized
    to be placed as dominant when it\u2019s passed on."
  DE: "Das ist \u201EDominante Priorit\xE4t\u201C.\nWenn du es benutzt, wird dieses
    Gen beim Vererben bevorzugt als dominant gesetzt."
  SP: "Esto es \u201CPrioridad dominante\u201D.\nAl usarlo, ese gen se prioriza para
    colocarse como dominante al heredarse."
  JP: "\u3053\u308C\u306F\u300C\u512A\u6027\u512A\u5148\u6A29\u300D\u3067\u3059\u3002\n\u4F7F\u3046\u3068\u3001\u305D\u306E\u907A\u4F1D\u5B50\u304C\u53D7\u3051\u7D99\u304C\u308C\u308B\u3068\u304D\u306B\u512A\u6027\u3068\u3057\u3066\u512A\u5148\u7684\u306B\u914D\u7F6E\u3055\u308C\u307E\u3059\u3002"
  CHS: "\u8FD9\u662F\u201C\u663E\u6027\u4F18\u5148\u6743\u201D\u3002\n\u4F7F\u7528\u540E\uFF0C\u8BE5\u57FA\u56E0\u5728\u4F20\u9012\u65F6\u4F1A\u4F18\u5148\u4F5C\u4E3A\u663E\u6027\u6392\u5217\u3002"
  CHT: "\u9019\u662F\u300C\u986F\u6027\u512A\u5148\u6B0A\u300D\u3002\n\u4F7F\u7528\u5F8C\uFF0C\u8A72\u57FA\u56E0\u5728\u50B3\u905E\u6642\u6703\u512A\u5148\u4F5C\u70BA\u986F\u6027\u6392\u5217\u3002"
