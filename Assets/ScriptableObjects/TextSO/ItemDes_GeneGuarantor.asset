  m_Script: {fileID: 11500000, guid: 3c7885e8e9a268046a087e585e2bd7f5, type: 3}
  m_Name: ItemDes_GeneGuarantor
  m_EditorClassIdentifier: 
  KOR: "\uC120\uD0DD\uD55C \uC720\uC804\uC790\uAC00 \uC790\uC2DD\uC5D0\uAC8C \uC6B0\uC131\uC73C\uB85C
    \uC720\uC804\uB429\uB2C8\uB2E4.\n<color=red>\uB2E8, \uAD50\uBC30 \uC0C1\uB300\uB3C4
    \uAC19\uC740 \uC720\uC804\uC790 \uD0C0\uC785\uC5D0 \uC6B0\uC120 \uC801\uC6A9\uC774
    \uB418\uC5B4 \uC788\uB2E4\uBA74 \uC6B0\uC131/\uC5F4\uC131\uC740 50:50 \uD655\uB960\uB85C
    \uACB0\uC815\uB429\uB2C8\uB2E4.</color>"
  ENG: 'The selected gene will be inherited as dominant by the child.

    <color=red>However,
    if the breeding partner also applies Dominant Priority to the same gene type,
    dominance/recessiveness is decided with a 50:50 chance.</color>'
  DE: "Das ausgew\xE4hlte Gen wird vom Kind dominant vererbt.\n<color=red>Wenn der
    Zuchtpartner jedoch ebenfalls Dominante Priorit\xE4t auf denselben Gentyp anwendet,
    wird Dominanz/Rezessivit\xE4t mit 50:50 Wahrscheinlichkeit entschieden.</color>"
  SP: "El gen seleccionado se heredar\xE1 como dominante.\n<color=red>Sin embargo,
    si la pareja de cr\xEDa tambi\xE9n aplica Prioridad dominante al mismo tipo de
    gen, la dominancia/recesividad se decide con una probabilidad 50:50.</color>"
  JP: "\u9078\u629E\u3057\u305F\u907A\u4F1D\u5B50\u304C\u5B50\u306B\u300C\u512A\u6027\u300D\u3068\u3057\u3066\u53D7\u3051\u7D99\u304C\u308C\u307E\u3059\u3002\n<color=red>\u305F\u3060\u3057\u3001\u4EA4\u914D\u76F8\u624B\u3082\u540C\u3058\u907A\u4F1D\u5B50\u30BF\u30A4\u30D7\u306B\u512A\u6027\u512A\u5148\u6A29\u3092\u9069\u7528\u3057\u3066\u3044\u308B\u5834\u5408\u3001\u512A\u6027\uFF0F\u52A3\u6027\u306F50:50\u306E\u78BA\u7387\u3067\u6C7A\u307E\u308A\u307E\u3059\u3002</color>"
  CHS: "\u6240\u9009\u57FA\u56E0\u5C06\u4EE5\u663E\u6027\u9057\u4F20\u7ED9\u5B50\u4EE3\u3002\n<color=red>\u4F46\u5982\u679C\u914D\u5BF9\u5BF9\u8C61\u4E5F\u5BF9\u76F8\u540C\u7684\u57FA\u56E0\u7C7B\u578B\u5E94\u7528\u4E86\u663E\u6027\u4F18\u5148\u6743\uFF0C\u5219\u663E\u6027/\u9690\u6027\u5C06\u4EE550:50\u7684\u6982\u7387\u51B3\u5B9A\u3002</color>"
  CHT: "\u6240\u9078\u57FA\u56E0\u5C07\u4EE5\u986F\u6027\u907A\u50B3\u7D66\u5B50\u4EE3\u3002\n<color=red>\u4F46\u5982\u679C\u914D\u5C0D\u5C0D\u8C61\u4E5F\u5C0D\u76F8\u540C\u7684\u57FA\u56E0\u985E\u578B\u5957\u7528\u4E86\u986F\u6027\u512A\u5148\u6B0A\uFF0C\u5247\u986F\u6027\uFF0F\u96B1\u6027\u5C07\u4EE550:50\u7684\u6A5F\u7387\u6C7A\u5B9A\u3002</color>"
