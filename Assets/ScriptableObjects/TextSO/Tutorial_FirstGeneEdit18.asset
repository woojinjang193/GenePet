  m_Script: {fileID: 11500000, guid: 3c7885e8e9a268046a087e585e2bd7f5, type: 3}
  m_Name: Tutorial_FirstGeneEdit18
  m_EditorClassIdentifier: 
  KOR: "\uB9C8\uC744\uC758 \uD398\uC774\uCF13 \uC720\uC804\uC790 \uD3B8\uC9D1 \uC815\uBCF4\uB294
    \uAD50\uBC30 \uD6C4\uC5D0\uB3C4 \uACC4\uC18D \uC720\uC9C0\uB41C\uB2F5\uB2C8\uB2E4!\n\uD558\uC9C0\uB9CC
    <color=red>\uB2E4\uB978 \uB9C8\uC744\uC758 \uD398\uC774\uCF13\uC758 \uC720\uC804\uC790
    \uD3B8\uC9D1 \uC815\uBCF4\uB294 \uC800\uC7A5\uB418\uC9C0\uC54A\uC73C\uB2C8 \uCC38\uACE0
    \uD574\uC8FC\uC138\uC694!</color>"
  ENG: 'Gene edit settings for village Faecats will remain even after breeding!

    But
    <color=red>gene edit settings for Faecats from other villages are not saved,
    so please keep that in mind!</color>'
  DE: "Die Gen-Bearbeitungsinfos von Faecats aus diesem Dorf bleiben auch nach der
    Zucht erhalten!\nAber <color=red>die Gen-Bearbeitungsinfos von Faecats aus anderen
    D\xF6rfern werden nicht gespeichert \u2013 bitte beachte das!</color>"
  SP: "\xA1La informaci\xF3n de edici\xF3n gen\xE9tica de los Faecats del pueblo
    se mantiene incluso despu\xE9s de la cr\xEDa!\nPero <color=red>la informaci\xF3n
    de edici\xF3n gen\xE9tica de los Faecats de otros pueblos no se guarda, tenlo
    en cuenta.</color>"
  JP: "\u3053\u306E\u6751\u306E\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306E\u907A\u4F1D\u5B50\u7DE8\u96C6\u60C5\u5831\u306F\u3001\u4EA4\u914D\u5F8C\u3082\u305A\u3063\u3068\u7DAD\u6301\u3055\u308C\u307E\u3059\uFF01\n\u305F\u3060\u3057<color=red>\u4ED6\u306E\u6751\u306E\u30D5\u30A7\u30A4\u30AD\u30E3\u30C3\u30C8\u306E\u907A\u4F1D\u5B50\u7DE8\u96C6\u60C5\u5831\u306F\u4FDD\u5B58\u3055\u308C\u306A\u3044\u306E\u3067\u6CE8\u610F\u3057\u3066\u304F\u3060\u3055\u3044\uFF01</color>"
  CHS: "\u672C\u6751\u8D39\u732B\u7684\u57FA\u56E0\u7F16\u8F91\u4FE1\u606F\u5728\u914D\u5BF9\u540E\u4E5F\u4F1A\u4E00\u76F4\u4FDD\u7559\uFF01\n\u4F46<color=red>\u5176\u4ED6\u6751\u5E84\u8D39\u732B\u7684\u57FA\u56E0\u7F16\u8F91\u4FE1\u606F\u4E0D\u4F1A\u88AB\u4FDD\u5B58\uFF0C\u8BF7\u6CE8\u610F\uFF01</color>"
  CHT: "\u672C\u6751\u8CBB\u8C93\u7684\u57FA\u56E0\u7DE8\u8F2F\u8CC7\u8A0A\u5728\u914D\u5C0D\u5F8C\u4E5F\u6703\u4E00\u76F4\u4FDD\u7559\uFF01\n\u4F46<color=red>\u5176\u4ED6\u6751\u838A\u8CBB\u8C93\u7684\u57FA\u56E0\u7DE8\u8F2F\u8CC7\u8A0A\u4E0D\u6703\u88AB\u4FDD\u5B58\uFF0C\u8ACB\u6CE8\u610F\uFF01</color>"
