  KOR: "\uC774\uAC74 \"\uC720\uC804\uC790 \uD480\"\uC774\uC5D0\uC694.\n\uC0AC\uC6A9\uD558\uBA74
    \uC798\uB9B0 \uC720\uC804\uC790\uB97C \uB2E4\uC2DC \uBD99\uC77C \uC218 \uC788\uC5B4\uC694."
  ENG: "This is \u201CGene Glue\u201D.\nUse it to reattach a cut gene."
  DE: "Das ist der \u201EGen-Kleber\u201C.\nDamit kannst du ein abgeschnittenes Gen
    wieder anf\xFCgen."
  SP: "Este es el \u201CPegamento gen\xE9tico\u201D.\nAl usarlo, puedes volver a
    pegar un gen cortado."
  JP: "\u3053\u308C\u306F\u300C\u907A\u4F1D\u5B50\u306E\u308A\u300D\u3067\u3059\u3002\n\u4F7F\u3046\u3068\u5207\u308A\u53D6\u3063\u305F\u907A\u4F1D\u5B50\u3092\u3082\u3046\u4E00\u5EA6\u304F\u3063\u3064\u3051\u3089\u308C\u307E\u3059\u3002"
  CHS: "\u8FD9\u662F\u201C\u57FA\u56E0\u80F6\u6C34\u201D\u3002\n\u4F7F\u7528\u540E\u53EF\u4EE5\u628A\u88AB\u526A\u6389\u7684\u57FA\u56E0\u91CD\u65B0\u7C98\u56DE\u53BB\u3002"
  CHT: "\u9019\u662F\u300C\u57FA\u56E0\u81A0\u6C34\u300D\u3002\n\u4F7F\u7528\u5F8C\u53EF\u4EE5\u628A\u88AB\u526A\u6389\u7684\u57FA\u56E0\u91CD\u65B0\u9ECF\u56DE\u53BB\u3002"
