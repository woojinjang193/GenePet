  JP: "\u3067\u3082\uFF01\n\u6B32\u3057\u3044\u907A\u4F1D\u5B50\u3092\u512A\u6027\u3068\u3057\u3066\u5B50\u306B\u53D7\u3051\u7D99\u304C\u305B\u308B\u3053\u3068\u3082\u3067\u304D\u307E\u3059\uFF01"
  CHS: "\u4F46\u662F\uFF01\n\u4F60\u4E5F\u53EF\u4EE5\u8BA9\u60F3\u8981\u7684\u57FA\u56E0\u4EE5\u663E\u6027\u4F20\u7ED9\u5B69\u5B50\uFF01"
